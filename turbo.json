{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "ANTHROPIC_API_KEY",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CHAT_AI_MODEL",
    "CLIENT_IP_HEADERS",
    "CRON_SECRET",
    "DATABASE_POOL_MAX",
    "DATABASE_URL",
    "E2E_SEED_SECRET",
    "EMAIL_FROM",
    "ERROR_WEBHOOK_URL",
    "FIELD_ENCRYPTION_KEY",
    "FILE_STORAGE",
    "FILE_STORAGE_DIR",
    "NEXT_PUBLIC_BASE_PATH",
    "NEXT_PUBLIC_BASE_URL",
    "NODE_ENV",
    "ORGANIZATIONS_PER_PERSON",
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "S3_ACCESS_KEY_ID",
    "S3_BUCKET",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_SECRET_ACCESS_KEY",
    "TEST_DATABASE_URL",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [],
      "cache": false
    }
  }
}
